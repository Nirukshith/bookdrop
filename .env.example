PORT=3000
NODE_ENV=development
DATABASE_URL="postgresql://bookdrop:bookdrop@localhost:5432/bookdrop?schema=public"
LIBRARY_TIMEZONE="Asia/Colombo"

# Authentication
JWT_ACCESS_SECRET="your-super-secret-jwt-access-key-min-32-chars-long"
JWT_ACCESS_TTL="15m"
REFRESH_TOKEN_TTL_DAYS=7

# Networking, Security & Production
# Set TRUST_PROXY=true ONLY behind a trusted reverse proxy (e.g. AWS ALB).
# CAUTION: Enabling this without a reverse proxy allows clients to spoof X-Forwarded-For and bypass rate limits.
TRUST_PROXY=false

# Comma-separated list of allowed CORS origins (e.g. "https://app.bookdrop.io,https://admin.bookdrop.io").
# Empty by default (no cross-origin browser access allowed).
ALLOWED_ORIGINS=""

# Demo Users Seed (Development only)
SEED_ADMIN_PASSWORD="AdminPassword123!"
SEED_LIBRARIAN_PASSWORD="LibrarianPassword123!"
SEED_MEMBER_PASSWORD="MemberPassword123!"
