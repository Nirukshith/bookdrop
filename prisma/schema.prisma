// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Book {
  id            Int        @id @default(autoincrement())
  title         String
  isbn          String     @unique
  description   String?
  publishedYear Int?
  authors       Author[]
  categories    Category[]
  copies        Copy[]
  createdAt     DateTime   @default(now())
}

model Author {
  id    Int    @id @default(autoincrement())
  name  String
  books Book[]
}

model Category {
  id    Int    @id @default(autoincrement())
  name  String @unique
  books Book[]
}

enum CopyStatus {
  AVAILABLE
  ON_HOLD
  BORROWED
  LOST
  DAMAGED
}

model Copy {
  id     Int        @id @default(autoincrement())
  bookId Int
  book   Book       @relation(fields: [bookId], references: [id])
  status CopyStatus @default(AVAILABLE)
}
