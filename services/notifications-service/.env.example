NODE_ENV=development
DATABASE_URL=postgresql://bookdrop:bookdrop@localhost:5433/bookdrop?schema=public
RABBITMQ_URL=amqp://bookdrop:bookdrop@localhost:5672

EMAIL_PROVIDER=console
EMAIL_FROM="Bookdrop Library <no-reply@bookdrop.io>"

# SMTP Configuration (when EMAIL_PROVIDER=smtp)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# AWS SES Configuration (when EMAIL_PROVIDER=ses)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Worker Settings
NOTIFICATION_LOCK_SECONDS=120
NOTIFICATION_BATCH_SIZE=20
NOTIFICATION_RATE_LIMIT_RPS=1
NOTIFICATION_BURST_CAPACITY=5
SCHEDULER_ENABLED=true

