{
  "family": "bookdrop-migration-task",
  "networkMode": "bridge",
  "requiresCompatibilities": ["EC2"],
  "executionRoleArn": "arn:aws:iam::060668531381:role/ecsTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "bookdrop-migration",
      "image": "060668531381.dkr.ecr.ap-south-1.amazonaws.com/bookdrop-api:latest",
      "essential": true,
      "memoryReservation": 350,
      "command": ["npx", "prisma", "migrate", "deploy"],
      "environment": [
        { "name": "NODE_ENV", "value": "production" }
      ],
      "secrets": [
        {
          "name": "DATABASE_URL",
          "valueFrom": "arn:aws:ssm:ap-south-1:060668531381:parameter/bookdrop/production/DATABASE_URL"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/bookdrop-api",
          "awslogs-region": "ap-south-1",
          "awslogs-stream-prefix": "migration"
        }
      }
    }
  ]
}
